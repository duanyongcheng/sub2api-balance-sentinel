{
  "name": "sub2api-balance-sentinel",
  "version": "1.0.0",
  "private": true,
  "description": "Monitor selected sub2api users and auto top-up when balance drops below a threshold, with a full audit ledger for reconciliation.",
  "type": "module",
  "scripts": {
    "dev:server": "node --watch server/src/index.js",
    "start": "node server/src/index.js",
    "dev:web": "vite --config web/vite.config.js",
    "build:web": "vite build --config web/vite.config.js",
    "preview": "npm run build:web && npm start",
    "hash-password": "node server/src/hash-password.js",
    "test": "node --test server/test/*.test.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@fontsource/fira-sans-condensed": "^5.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.7"
  }
}
