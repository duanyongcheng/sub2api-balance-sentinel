      "refersTo": "action-board",
      "description": "Signature navy timetable row: time, user, matter, amount, state, action.",
      "html": "<div class=\"ds-board\"><div class=\"ds-row\"><span class=\"ds-time\">12:06</span><span class=\"ds-user\">#1<small>alice@relay.cn</small></span><span class=\"ds-what\">余额 3.20，低于阈值 10.00<small>加后预计 103.20</small></span><span class=\"ds-amt\">+100.00</span><span class=\"ds-state\">待审批</span><button class=\"ds-approve\">批准并加额</button></div></div>",
      "css": ".ds-board{background:#0e2a52;color:#fff;border-radius:2px;font-family:\"PingFang SC\",system-ui,sans-serif}.ds-row{display:grid;grid-template-columns:72px 120px minmax(0,1fr) 112px 84px auto;column-gap:16px;align-items:center;min-height:76px;padding:12px 24px;border-bottom:1px solid #29497a;transition:background .15s}.ds-row:hover{background:#163a6b}.ds-time,.ds-amt{font:500 26px/1.1 \"Fira Sans Condensed\",sans-serif;font-variant-numeric:tabular-nums}.ds-time{color:#c3d1e6}.ds-amt{text-align:right}.ds-user{display:grid;font:600 22px/1.3 \"Fira Sans Condensed\",sans-serif}.ds-user small,.ds-what small{display:block;font:12px \"PingFang SC\",sans-serif;color:#93a8c8}.ds-what{font-size:15px}.ds-state{font-size:20px;font-weight:600;letter-spacing:.06em;color:#f2b705}.ds-approve{min-height:34px;padding:6px 14px;border:1px solid #f2b705;border-radius:2px;background:#f2b705;color:#1b1600;font:600 13px \"PingFang SC\",sans-serif;cursor:pointer}.ds-approve:hover{background:#ffc61a}.ds-approve:focus-visible{outline:2px solid #fff;outline-offset:2px}"
    },
