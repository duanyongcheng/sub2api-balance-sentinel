      "css": ".ds-badge{display:inline-block;padding:1px 7px;border:1px solid #d8dee8;border-radius:2px;font:500 12px/18px \"PingFang SC\",system-ui,sans-serif;white-space:nowrap}.ds-ok{color:#18744a;border-color:#a9dbbf;background:#e6f5ec}.ds-caution{color:#855800;border-color:#e7cd85;background:#fdf3d8}.ds-danger{color:#c22f35;border-color:#f0b0b2;background:#fdeced}.ds-muted{color:#5f6c84;background:#f7f8fb}"
