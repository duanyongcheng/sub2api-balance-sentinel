# ---------------------------------------------------------------------------
# sub2api-balance-sentinel configuration
#
# Copy this file to `.env` and fill in the real values.
# `.env` is git-ignored and must be chmod 600.
#
# SECURITY: SUB2API_ADMIN_API_KEY grants FULL admin rights over the entire
# sub2api instance (all users, account credentials, system settings).
# There is no scoped/limited admin key in sub2api. Treat it like a root password:
#   - keep it only in this file, never in code, chat, screenshots or commits
#   - run this service on loopback behind an authenticated reverse proxy
#   - rotate it in sub2api > Settings if it ever leaks
# ---------------------------------------------------------------------------

SUB2API_BASE_URL=http://127.0.0.1:8080
# Fill this in, or leave it empty and use SUB2API_ADMIN_API_KEY_FILE below.
SUB2API_ADMIN_API_KEY=
# Use either the value above OR the _FILE path below, never both. For _FILE,
# mount the secret read-only inside the container and set its in-container path.
# A trailing newline in a secret file is ignored.
SUB2API_ADMIN_API_KEY_FILE=
# Only enable this when sub2api is reachable over a trusted isolated private network.
ALLOW_INSECURE_SUB2API_HTTP=false

# Where the audit ledger lives.
SENTINEL_DB_PATH=./data/sentinel.db

# Web UI / API listener. Keep 127.0.0.1 unless you fully trust the network.
HOST=127.0.0.1
PORT=7788

# How often to poll balances (minimum 10000 ms).
MONITOR_INTERVAL_MS=60000

# Master switch for writing. false = observe and record only, never mutate.
# Recommended first run: set this to false, watch the dashboard, then enable.
AUTO_TOPUP_ENABLED=false

# ---- Hard safety ceilings (apply to every user, always) ----
# Maximum a single top-up may credit.
GUARD_MAX_TOPUP_PER_EVENT=100
# Maximum number of automatic top-ups per user per day.
GUARD_MAX_TOPUPS_PER_USER_PER_DAY=5
# Maximum total credited per user per day.
GUARD_MAX_TOPUP_TOTAL_PER_DAY=1000
# Stop writing after this many consecutive failures.
GUARD_CIRCUIT_BREAKER_FAILURES=3

REQUEST_TIMEOUT_MS=15000

# ---- Dashboard authentication (required) ----
# Password-only login is the default. No authenticator or account key is needed.
AUTH_REQUIRE_TOTP=false
# Generate the hash without storing a plaintext password or exposing it in shell history:
#   read -r -s -p 'Sentinel password: ' SENTINEL_PASSWORD; printf '\n'
#   printf '%s' "$SENTINEL_PASSWORD" | node server/src/hash-password.js; unset SENTINEL_PASSWORD
SENTINEL_ADMIN_USERNAME=admin
# Fill this in, or leave it empty and use SENTINEL_ADMIN_PASSWORD_HASH_FILE below.
SENTINEL_ADMIN_PASSWORD_HASH=
# As with the Sub2API key, use either the value or its _FILE alternative.
SENTINEL_ADMIN_PASSWORD_HASH_FILE=
# Optional: only used when AUTH_REQUIRE_TOTP=true.
# Generate once with `node server/src/generate-totp.js`; enroll it in an authenticator app.
# Fill this in, or leave it empty and use SENTINEL_ADMIN_TOTP_SECRET_FILE below.
SENTINEL_ADMIN_TOTP_SECRET=
SENTINEL_ADMIN_TOTP_SECRET_FILE=
# Optional: encrypts each managed account's MFA secret with AES-256-GCM.
# Only required for creating/resetting accounts when AUTH_REQUIRE_TOTP=true.
# In password-only mode these MFA secret settings are ignored. Generate ONCE
# if enabling MFA; never replace an existing key casually or lose its backup:
#   node server/src/generate-account-key.js --output ./secrets/account-key
# Mount that file read-only in Docker and use the in-container _FILE path.
SENTINEL_ACCOUNT_KEY=
SENTINEL_ACCOUNT_KEY_FILE=
# Set true when the dashboard is served over HTTPS. Keep false only for local HTTP.
AUTH_SECURE_COOKIES=false
# Session lifetime and idle timeout in milliseconds.
AUTH_SESSION_TTL_MS=28800000
AUTH_IDLE_TIMEOUT_MS=3600000
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOGIN_WINDOW_MS=900000

# For remote access through a reverse proxy, list exact host[:port] values.
# Example: ALLOWED_HOSTS=sentinel.example.com
ALLOWED_HOSTS=

# ---- Notifications (optional) ----
# Leave NOTIFY_WEBHOOK_URL empty to disable notifications.
# NOTIFY_FORMAT: wecom | feishu | dingtalk | slack | generic
NOTIFY_FORMAT=wecom
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_URL_FILE=
# Categories: topup, unknown, failure, circuit, proposal  (or "all")
NOTIFY_ON=topup,unknown,failure,circuit,proposal
